# Copy to .env and fill in. Used by docker-compose.
# The domain you'll route to this box (must resolve to it before `up`).
DOMAIN=interview.example.com
# Email for the Let's Encrypt account (recommended; can be left blank).
ACME_EMAIL=you@example.com
# How long an idle pad is kept before expiry.
EXPIRY_DAYS=30
# Signs interviewer sessions. At least 32 bytes: `openssl rand -hex 32`.
# setup-host.sh generates one.
SESSION_SECRET=
# Google OAuth client (Internal app in the withrebar.ai Workspace). Redirect URI:
# https://<DOMAIN>/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only members of this Google Workspace domain can sign in.
GOOGLE_ALLOWED_DOMAIN=withrebar.ai
# Interview Assistant (server-only; never use a VITE_ prefix for secrets).
OPENAI_API_KEY=
LUNA_ENABLED=1
