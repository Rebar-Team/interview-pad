{
    auto_https off
    admin off
}

:3030 {
    # `handle` blocks are mutually exclusive; `route` keeps the order as
    # written: check the room, strip /pty so ptyd sees /<padId>, proxy.
    handle /pty/* {
        route {
            forward_auth rustpad:3030 {
                uri /api/pty-auth
                copy_headers X-Room-Expires-At
            }
            uri strip_prefix /pty
            reverse_proxy ptyd:8081
        }
    }
    handle {
        reverse_proxy rustpad:3030
    }
}
