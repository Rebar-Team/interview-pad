# Automatic HTTPS for InterviewPad.
#
# Caddy provisions a Let's Encrypt cert for $DOMAIN over the HTTP-01 challenge,
# so ports 80 and 443 must be publicly reachable and the Cloudflare DNS record
# should be "DNS only" (grey cloud). See DEPLOY.md.

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# Interactive terminal WebSocket -> ptyd, only while the room is writable.
	# Rustpad's gate passes the room's lock time on to ptyd. `route` keeps the
	# order as written: check the room, strip /pty so ptyd sees /<padId>, proxy.
	handle /pty/* {
		route {
			forward_auth rustpad:3030 {
				uri /api/pty-auth
				copy_headers X-Room-Expires-At
			}
			uri strip_prefix /pty
			reverse_proxy ptyd:8081
		}
	}

	# Everything else -> Rustpad (editor UI + /api/socket collaboration WS).
	handle {
		reverse_proxy rustpad:3030
	}
}
